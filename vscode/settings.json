{
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "accessibility.verbosity.panelChat": false,
  "auto-close-tag.fullMode": false,
  "biome.suggestInstallingGlobally": false,
  "breadcrumbs.enabled": false,
  "chaliceIcons.showArrows": true,
  "chat.detectParticipant.enabled": false,
  "chat.mcp.gallery.enabled": true,
  "chat.restoreLastPanelSession": false,
  "commit-message-editor.view.defaultView": "form",
  "commit-message-editor.view.fullWidth": true,
  "commit-message-editor.view.visibleViews": "form",
  "css.lint.unknownAtRules": "ignore",
  "custom-ui-style.font.monospace": "SF Mono",
  "custom-ui-style.font.sansSerif": "SF Mono",
  "custom-ui-style.preferRestart": true,
  "custom-ui-style.reloadWithoutPrompting": true,
  "debug.allowBreakpointsEverywhere": true,
  "debug.console.fontFamily": "SF Mono",
  "debug.console.fontSize": 14,
  "debug.showBreakpointsInOverviewRuler": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.bracketPairColorization.enabled": false,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "editor.cursorWidth": 4,
  "editor.detectIndentation": true,
  "editor.dragAndDrop": false,
  "editor.fontFamily": "SF Mono, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.fontWeight": "500",
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.glyphMargin": true,
  "editor.guides.bracketPairs": false,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.highlightActiveBracketPair": false,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.hover.delay": 200,
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.largeFileOptimizations": true,
  "editor.lineHeight": 1.25,
  "editor.lineNumbers": "on",
  "editor.linkedEditing": true,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.overviewRulerBorder": false,
  "editor.quickSuggestions": {
    "comments": "on",
    "other": "on",
    "strings": "on"
  },
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "none",
  "editor.scrollbar.horizontalScrollbarSize": 4,
  "editor.scrollbar.verticalScrollbarSize": 4,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.suggest.preview": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.allowedCharacters": {
    " ": true
  },
  "editor.wordWrap": "off",
  "explorer.autoReveal": true,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 1,
  "explorer.sortOrder": "type",
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "off",
  "git-graph.commitDetailsView.fileView.type": "File List",
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.ignoreRebaseWarning": true,
  "javascript.format.insertSpaceBeforeFunctionParenthesis": true,
  "javascript.preferGoToSourceDefinition": true,
  "javascript.preferences.importModuleSpecifierEnding": "minimal",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "markdown.preview.fontSize": 14,
  "markdown.preview.lineHeight": 1.5,
  "markdown.preview.scrollEditorWithPreview": false,
  "markdown.preview.scrollPreviewWithEditor": false,
  "markdown.preview.typographer": true,
  "markdownlint.config": {
    "MD024": false,
    "default": true,
    "first-line-heading": false,
    "no-inline-html": false
  },
  "notebook.breadcrumbs.showCodeCells": false,
  "notebook.outline.showCodeCells": true,
  "polacode.shadow": "rgba(0, 0, 0, 0.75) 0px 20px 68px",
  "polacode.transparentBackground": true,
  "projectManager.git.baseFolders": [
    "~/repos"
  ],
  "projectManager.vscode.baseFolders": [
    "~/repos"
  ],
  "redhat.telemetry.enabled": false,
  "search.quickOpen.history.filterSortOrder": "recency",
  "search.showLineNumbers": true,
  "search.sortOrder": "type",
  "security.workspace.trust.untrustedFiles": "open",
  "settingsSync.ignoredSettings": [
    "projectManager.git.baseFolders"
  ],
  "telemetry.telemetryLevel": "all",
  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.enableFileLinks": "on",
  "terminal.integrated.fontFamily": "SF Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.tabs.location": "left",
  "typescript.format.insertSpaceBeforeFunctionParenthesis": true,
  "typescript.preferGoToSourceDefinition": true,
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "update.mode": "default",
  "update.showReleaseNotes": false,
  "window.commandCenter": false,
  "window.confirmSaveUntitledWorkspace": false,
  "window.nativeTabs": true,
  "window.restoreFullscreen": true,
  "window.titleBarStyle": "native",
  "window.zoomLevel": 2,
  "workbench.colorCustomizations": {
    "editorIndentGuide.activeBackground1": "#00000000"
  },
  "workbench.colorTheme": "Sequoia Moonlight",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.enablePreview": false,
  "workbench.editor.focusRecentEditorAfterClose": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.showIcons": true,
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.enableExperiments": false,
  "workbench.layoutControl.enabled": false,
  "workbench.list.defaultFindMatchType": "contiguous",
  "workbench.list.horizontalScrolling": true,
  "workbench.list.smoothScrolling": true,
  "workbench.panel.opensMaximized": "always",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 13,
  "workbench.tree.renderIndentGuides": "none",
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!If",
    "!If sequence",
    "!Not",
    "!Not sequence",
    "!Equals",
    "!Equals sequence",
    "!Or",
    "!Or sequence",
    "!FindInMap",
    "!FindInMap sequence",
    "!Base64",
    "!Join",
    "!Join sequence",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!Sub sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!ImportValue sequence",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence"
  ],
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideLineNumbers": true,
  "zenMode.hideStatusBar": true,
  "zenMode.restore": true,
  "zenMode.showTabs": "single",
  "zenMode.silentNotifications": true,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "claudeCode.preferredLocation": "panel",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true
},
"terminal.integrated.mouseWheelScrollSensitivity": 3,
"custom-ui-style.background.opacity": 1,
"chat.titleBar.signIn.enabled": false,
"window.customTitleBarVisibility": "never",
"git.replaceTagsWhenPull": true,
"chat.disableAIFeatures": true
}