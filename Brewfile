# Everything Homebrew installs. Apply with `brew bundle` (install.sh does this).
# See what's installed but missing from here with `brew bundle cleanup`.

# --- Shell -------------------------------------------------------------------
brew "pure"                     # minimal prompt (successor of the oh-my-zsh "refined" theme)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"
brew "fzf"                      # fuzzy finder: Ctrl-R history, Ctrl-T files
brew "zoxide"                   # smarter cd: `z repo`
brew "pam-reattach"             # Touch ID for sudo inside tmux

# --- Git ---------------------------------------------------------------------
brew "git"
brew "gh"
brew "git-delta"                # syntax-highlighted diffs
brew "lazygit"

# --- Languages & runtimes ----------------------------------------------------
brew "mise"                     # node, pnpm, bun… (replaces nvm), see mise/config.toml
brew "uv"                       # python
brew "rustup"

# --- CLI essentials ----------------------------------------------------------
brew "bat"                      # cat with highlighting
brew "eza"                      # modern ls
brew "fd"
brew "ripgrep"
brew "jq"
brew "htop"
brew "tmux"
brew "yazi"                     # terminal file manager
brew "tlrc"                     # `tldr` pages
brew "wget"

# --- Fonts -------------------------------------------------------------------
cask "font-sf-mono"             # editor + terminal font used in vscode/settings.json
cask "font-symbols-only-nerd-font"

# --- Apps --------------------------------------------------------------------
cask "1password"
cask "arc"
cask "docker-desktop"
cask "google-drive"
cask "meetingbar"
cask "raycast"
cask "spotify"
cask "tableplus"
cask "visual-studio-code"
cask "vlc"
