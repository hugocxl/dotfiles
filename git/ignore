# (dist, coverage, .next…) belongs in each repo's own .gitignore.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
*.swp
*.swo
*~

# Secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
